{
  "name": "@isocialpractice/cmd-sync-servers",
  "version": "1.0.0-alpha.1.0.0",
  "description": "Cross-platform command-line site synchronization with a library API, modelled on Dreamweaver's Synchronize: sites, servers, cloaking and a preview of every change.",
  "keywords": [
    "sync",
    "synchronize",
    "sftp",
    "ftps",
    "ftp",
    "deploy",
    "dreamweaver",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://isocialpractice.github.io/cmd-sync-servers/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isocialPractice/cmd-sync-servers.git"
  },
  "bugs": {
    "url": "https://github.com/isocialPractice/cmd-sync-servers/issues"
  },
  "type": "module",
  "bin": {
    "sync-servers": "./out/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./credentials/keyring": {
      "types": "./out/credentials/keyring.d.ts",
      "default": "./out/credentials/keyring.js"
    },
    "./schema/site.schema.json": "./schema/site.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "out",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "node scripts/clean.ts out && tsc -p tsconfig.json && node scripts/generate-schema.ts",
    "schema": "node scripts/generate-schema.ts",
    "typecheck": "tsc -p tsconfig.dev.json",
    "lint": "eslint .",
    "test": "npm run build && node scripts/run-tests.ts unit integration e2e docs",
    "test:unit": "node scripts/run-tests.ts unit",
    "test:integration": "node scripts/run-tests.ts integration",
    "test:e2e": "npm run build && node scripts/run-tests.ts e2e",
    "test:docs": "node scripts/run-tests.ts docs",
    "test:docker": "node scripts/run-tests.ts docker",
    "coverage": "node scripts/run-tests.ts --coverage unit integration && node scripts/coverage-check.ts coverage/lcov.info",
    "sandbox": "node test/sandbox/run.ts",
    "vendor:kilo": "node scripts/vendor-kilo.ts",
    "pack:check": "npm run build && node scripts/pack-check.ts",
    "docs:api": "typedoc",
    "docs:cli": "node scripts/docs-cli.ts",
    "docs:site": "node scripts/build-site.ts && npm run docs:api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/ssh2": "1.15.6",
    "eslint": "10.13.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "basic-ftp": "6.2.3",
    "diff": "9.0.0",
    "ignore": "7.0.14",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.2"
  },
  "overrides": {
    "@types/ssh2": {
      "@types/node": "$@types/node"
    }
  }
}
