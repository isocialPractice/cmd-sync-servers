{
  "name": "@isocialpractice/cmd-sync-servers",
  "version": "1.0.0-alpha.0.0.0",
  "description": "Cross-platform command-line site synchronization with a library API, modelled on Dreamweaver's Synchronize: sites, servers, cloaking and a preview of every change.",
  "keywords": [
    "sync",
    "synchronize",
    "sftp",
    "ftps",
    "ftp",
    "deploy",
    "dreamweaver",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://isocialpractice.github.io/cmd-sync-servers/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isocialPractice/cmd-sync-servers.git"
  },
  "bugs": {
    "url": "https://github.com/isocialPractice/cmd-sync-servers/issues"
  },
  "type": "module",
  "bin": {
    "sync-servers": "./out/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "out",
    "schema",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "node scripts/clean.ts out && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.dev.json",
    "lint": "eslint .",
    "test": "npm run build && node scripts/run-tests.ts unit integration e2e docs",
    "test:unit": "node scripts/run-tests.ts unit",
    "test:integration": "node scripts/run-tests.ts integration",
    "test:e2e": "npm run build && node scripts/run-tests.ts e2e",
    "test:docs": "node scripts/run-tests.ts docs",
    "pack:check": "npm run build && node scripts/pack-check.ts",
    "docs:api": "typedoc --entryPoints src/index.ts --tsconfig tsconfig.json --out _site/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
